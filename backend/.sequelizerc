const path = require("path");

// Loads migrations/models straight from TypeScript source via ts-node/register, the same
// way training-portal does -- so the runtime container needs src/ + tsconfig.json +
// full node_modules present, not just dist/.
require("ts-node/register");

module.exports = {
  config: path.resolve("src/config", "database.js"),
  "migrations-path": path.resolve("src", "migrations"),
  "models-path": path.resolve("src", "models"),
  "seeders-path": path.resolve("src", "seeders"),
};
