# Copy to .env for local development. In production (Render) these are set in the
# dashboard instead -- see render.yaml and DEPLOYMENT.md.

NODE_ENV=development
PORT=4100
CORS_ORIGIN=http://localhost:5174

DATABASE_URL=postgres://hellocare_email:change_me@localhost:5433/hellocare_email_dev

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Same cPanel/InMotion mail server for all three accounts -- only the mailbox user/pass
# differ per account. Ask InMotion support or check cPanel > Email Accounts > Connect
# Devices for the exact host/port/SSL settings for hellocareconsulting.com.
SMTP_HOST=mail.hellocareconsulting.com
SMTP_PORT=465
SMTP_SECURE=true

# Each mailbox's OWN password (its normal cPanel webmail password, or a dedicated
# app-specific password if the mailbox supports one) -- never the same password reused
# across accounts, and never committed to git.
SMTP_PASS_INFO=
SMTP_PASS_KEN=
SMTP_PASS_ISABELLA=
